---
const waNumber = import.meta.env.WHATSAPP_NUMBER || '40750208299';
---

<section class="section" id="calculator" data-wa-number={waNumber}>
  <div class="container" style="text-align: center;">
    <p class="section__pretitle">Sistem de calificare</p>
    <h2 class="section__title">Configurează-ți pachetul de meditații</h2>
    <p class="section__subtitle" style="margin-left:auto;margin-right:auto;">Află de câte ore ai nevoie și programează prima ședință direct aici.</p>

    <div class="calculator" id="calc-wizard">
      <div class="calculator__progress">
        <div class="calculator__progress-bar calculator__progress-bar--active" data-step="1"></div>
        <div class="calculator__progress-bar" data-step="2"></div>
        <div class="calculator__progress-bar" data-step="3"></div>
        <div class="calculator__progress-bar" data-step="4"></div>
        <div class="calculator__progress-bar" data-step="5"></div>
      </div>

      <!-- Step 1: Subject -->
      <div class="calculator__step calculator__step--active" data-step="1">
        <h3 class="calculator__question">La ce materie ai nevoie de ajutor?</h3>
        <div class="calculator__options">
          <button class="calculator__option" data-value="Geometrie Descriptivă" data-next="2">📐 Geometrie Descriptivă (GD)</button>
          <button class="calculator__option" data-value="Analiză Matematică" data-next="2">📊 Analiză Matematică 1</button>
          <button class="calculator__option" data-value="Mecanică 1 (Statică & Cinematică)" data-next="2">⚙️ Mecanică 1 (Statică & Cinematică)</button>
          <button class="calculator__option" data-value="Mecanică 2 (Dinamică)" data-next="2">🚀 Mecanică 2 (Dinamică)</button>
          <button class="calculator__option" data-value="Desen Tehnic Industrial" data-next="2">📏 Desen Tehnic Industrial</button>
        </div>
      </div>

      <!-- Step 2: Level -->
      <div class="calculator__step" data-step="2">
        <button class="btn-back" data-back="1">← Înapoi</button>
        <h3 class="calculator__question">Care e nivelul tău actual?</h3>
        <div class="calculator__options">
          <button class="calculator__option" data-value="zero" data-next="3">📉 Nivel începător (am nevoie de explicații de la zero)</button>
          <button class="calculator__option" data-value="mediu" data-next="3">📈 Nivel mediu (înțeleg baza, dar am dificultăți la aplicații)</button>
          <button class="calculator__option" data-value="avansat" data-next="3">⭐ Nivel avansat (vizez o notă de top pentru bursă)</button>
        </div>
      </div>

      <!-- Step 3: Time -->
      <div class="calculator__step" data-step="3">
        <button class="btn-back" data-back="2">← Înapoi</button>
        <h3 class="calculator__question">Cât timp mai ai până la examen?</h3>
        <div class="calculator__options">
          <button class="calculator__option" data-value="urgent" data-next="result">⚡ Sub 3 zile (sesiune de urgență pentru examen)</button>
          <button class="calculator__option" data-value="scurt" data-next="result">⏳ 1-2 săptămâni (pregătire intensivă pe ultima sută de metri)</button>
          <button class="calculator__option" data-value="lung" data-next="result">📅 Suntem în timpul semestrului (pregătire continuă, fără presiune)</button>
        </div>
      </div>

      <!-- Result (Intermediate) -->
      <div class="calculator__step" data-step="result">
        <button class="btn-back" data-back="3" style="margin-bottom: 1rem;">← Înapoi</button>
        <div class="calculator__result">
          <div class="calculator__result-icon" id="calc-result-icon"></div>
          <h3 class="calculator__result-title" id="calc-result-title"></h3>
          <p class="calculator__result-desc" id="calc-result-desc"></p>
          <p id="calc-result-price-label" style="font-weight: bold; color: var(--accent-light); margin-bottom: 1.5rem;"></p>
          
          <button class="btn btn--primary" id="btn-continue-form">
            Continuă cu acest pachet →
          </button>
          <button class="btn btn--outline" style="margin-top: 1rem; margin-left: 0.5rem;" id="calc-reset">Refă testul</button>
        </div>
      </div>

      <!-- Step 4: Qualification Form -->
      <div class="calculator__step" data-step="4">
        <button class="btn-back" data-back="result">← Înapoi</button>
        <h3 class="calculator__question">Hai să ne cunoaștem situația</h3>
        
        <div class="funnel-form">
          <div class="form-group">
            <label for="f_facultate">La ce facultate ești?</label>
            <select id="f_facultate" class="form-input" required>
              <option value="" disabled selected>Alege facultatea...</option>
              <option value="FIMM">FIMM</option>
              <option value="ETTI">ETTI</option>
              <option value="Transporturi">Transporturi</option>
              <option value="Energetica">Energetică</option>
              <option value="SIM">SIM</option>
              <option value="FILS">FILS</option>
              <option value="Aerospatiale">Aerospațiale</option>
              <option value="Alta">Alta (specifică tu)</option>
            </select>
            <input type="text" id="f_facultate_other" class="form-input" placeholder="Scrie facultatea ta..." style="display: none; margin-top: 0.5rem;">
          </div>

          <div class="form-group">
            <label for="f_an">În ce an ești?</label>
            <select id="f_an" class="form-input" required>
              <option value="" disabled selected>Alege anul...</option>
              <option value="Anul 1">Anul 1</option>
              <option value="Anul 2">Anul 2</option>
              <option value="Anul 3">Anul 3 (Restanțier)</option>
              <option value="Anul 4">Anul 4+ (Restanțier)</option>
            </select>
          </div>

          <div class="form-group">
            <label>Ai modele de subiecte / examene din anii trecuți?</label>
            <div class="radio-group">
              <label class="radio-label"><input type="radio" name="f_subiecte" value="Da"> Da, le am pe grup</label>
              <label class="radio-label"><input type="radio" name="f_subiecte" value="Nu"> Nu, nu am nimic</label>
            </div>
          </div>

          <div class="form-group checkbox-group" style="margin-bottom: -0.5rem;">
            <label class="checkbox-label">
              <input type="checkbox" id="f_acord_online" required>
              <span id="label-acord-online">Am înțeles că meditațiile se desfășoară <strong>exclusiv online</strong> (nu fizic).</span>
            </label>
          </div>

          <div class="form-group checkbox-group">
            <label class="checkbox-label">
              <input type="checkbox" id="f_acord_pret" required>
              <span id="label-acord-pret">Sunt de acord cu tariful afișat (plata se face după ședință).</span>
            </label>
          </div>

          <div class="form-group" style="margin-top: 0.5rem;">
            <label for="f_mentiuni">Mențiuni / Modificări pachet (opțional)</label>
            <textarea id="f_mentiuni" class="form-input" placeholder="Dacă vrei mai multe ore sau să modifici ceva la pachet, scrie aici..." rows="2" style="resize: vertical;"></textarea>
          </div>

          <div id="error-step4" style="color: var(--accent-red); font-size: 0.9rem; font-weight: 500; display: none; margin-top: 0.5rem; text-align: center;"></div>

          <button class="btn btn--primary" id="btn-to-step5" style="width: 100%; justify-content: center; margin-top: 0.5rem;">
            Ultimul pas →
          </button>
        </div>
      </div>

      <!-- Step 5: Contact -->
      <div class="calculator__step" data-step="5">
        <button class="btn-back" data-back="4">← Înapoi</button>
        <h3 class="calculator__question">Unde te putem contacta?</h3>
        
        <div class="funnel-form">
          <!-- Honeypot Field (Hidden from real users) -->
          <input type="text" id="b_website" name="b_website" style="opacity: 0; position: absolute; pointer-events: none; z-index: -1;" tabindex="-1" autocomplete="off" placeholder="Nu completa acest câmp">

          <div class="form-group">
            <label for="f_nume">Cum te numești?</label>
            <input type="text" id="f_nume" class="form-input" placeholder="Ex: Alexandru Popescu" required>
            <div id="error-f_nume" class="field-error"></div>
          </div>

          <div class="form-group">
            <label for="f_telefon">Număr de WhatsApp</label>
            <input type="tel" id="f_telefon" class="form-input" placeholder="07XX XXX XXX" required>
            <div id="error-f_telefon" class="field-error"></div>
            <small style="color: var(--text-muted); display: block; margin-top: 0.25rem;">Ca să te putem contacta direct dacă se pierde mesajul.</small>
          </div>

          <div class="form-group">
            <label for="f_email">Adresă de email (opțională)</label>
            <input type="email" id="f_email" class="form-input" placeholder="Ex: nume@exemplu.ro">
            <div id="error-f_email" class="field-error"></div>
          </div>

          <div class="form-group checkbox-group" style="margin-top: 0; padding: 0.8rem;">
            <label class="checkbox-label" style="align-items: center;">
              <input type="checkbox" id="f_newsletter">
              <span>Vreau să primesc materiale gratuite și sfaturi utile pe email.</span>
            </label>
          </div>

          <div class="form-group checkbox-group" style="margin-top: 0.5rem; padding: 0.8rem; background: rgba(108, 92, 231, 0.05); border-radius: var(--radius-md);">
            <label class="checkbox-label" style="align-items: flex-start;">
              <input type="checkbox" id="f_acord_legal">
              <span style="font-size: 0.85rem; line-height: 1.4;">Sunt de acord cu <a href="/termeni-si-conditii" target="_blank" style="color: var(--accent); text-decoration: underline;">Termenii și Condițiile</a> și <a href="/politica-de-confidentialitate" target="_blank" style="color: var(--accent); text-decoration: underline;">Politica de Confidențialitate</a>.</span>
            </label>
            <div id="error-f_acord_legal" class="field-error"></div>
          </div>

          <div id="error-step5" style="color: var(--accent-red); font-size: 0.9rem; font-weight: 500; display: none; margin-top: 0.5rem; text-align: center;"></div>

          <button class="btn btn--whatsapp" id="btn-submit-funnel" style="width: 100%; justify-content: center; margin-top: 0.5rem;">
            <svg class="btn__icon" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
            </svg>
            Trimite & Deschide WhatsApp
          </button>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .btn-back {
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    padding: 0;
    margin-bottom: -0.5rem;
    transition: color var(--transition-fast);
  }
  .btn-back:hover {
    color: var(--text-primary);
  }

  .funnel-form {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    text-align: left;
    max-width: 100%;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .form-input {
    width: 100%;
    padding: 0.8rem 1rem;
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font-family: inherit;
    font-size: 1rem;
    transition: border-color var(--transition-fast);
  }

  .form-input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 2px rgba(108, 92, 231, 0.2);
  }

  .radio-group {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .radio-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-primary);
    cursor: pointer;
    font-weight: normal !important;
  }

  .radio-label:has(input:checked) {
    border-color: var(--accent);
    background: rgba(108, 92, 231, 0.1);
  }

  .checkbox-group {
    margin-top: 0.5rem;
    padding: 1rem;
    background: rgba(108, 92, 231, 0.05);
    border: 1px solid var(--border-accent);
    border-radius: var(--radius-md);
  }

  .checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
    cursor: pointer;
    font-weight: normal !important;
    line-height: 1.4;
  }

  .checkbox-label input {
    margin-top: 3px;
    width: 18px;
    height: 18px;
    accent-color: var(--accent);
  }

  .field-error {
    color: var(--accent-red);
    font-size: 0.85rem;
    font-weight: 500;
    margin-top: 0.25rem;
    display: none;
  }
</style>

<script>
  import { formSchema } from '../utils/schema';
  const loadTime = Date.now();

  const wizard = document.getElementById('calc-wizard');
  if (wizard) {
    const state: Record<string, string> = {};

    // Show custom facultate input if "Alta" is selected
    document.getElementById('f_facultate')?.addEventListener('change', (e) => {
      const select = e.target as HTMLSelectElement;
      const otherInput = document.getElementById('f_facultate_other') as HTMLInputElement;
      if (select.value === 'Alta') {
        otherInput.style.display = 'block';
        otherInput.required = true;
      } else {
        otherInput.style.display = 'none';
        otherInput.required = false;
      }
    });

    // Steps 1-3 Handlers
    wizard.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const option = target.closest('.calculator__option') as HTMLElement;

      if (option) {
        const currentStep = option.closest('.calculator__step') as HTMLElement;
        const stepNum = currentStep?.dataset.step;
        const value = option.dataset.value || '';
        const nextStep = option.dataset.next || '';

        if (stepNum) state[`step${stepNum}`] = value;

        currentStep?.querySelectorAll('.calculator__option').forEach(o => o.classList.remove('calculator__option--selected'));
        option.classList.add('calculator__option--selected');

        setTimeout(() => {
          goToStep(currentStep, nextStep);
          if (nextStep === 'result') showResult();
        }, 200);
      }
    });

    // Back Button Handler
    wizard.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.classList.contains('btn-back')) {
        const backTo = target.dataset.back;
        const currentStep = target.closest('.calculator__step') as HTMLElement;
        if (backTo && currentStep) {
          goToStep(currentStep, backTo);
        }
      }
    });

    // Helper to transition steps
    function goToStep(currentEl: HTMLElement, nextStepValue: string) {
      currentEl.classList.remove('calculator__step--active');
      const nextEl = wizard?.querySelector(`.calculator__step[data-step="${nextStepValue}"]`) as HTMLElement;
      nextEl?.classList.add('calculator__step--active');

      // Update progress bar
      wizard?.querySelectorAll('.calculator__progress-bar').forEach(bar => {
        const barStep = (bar as HTMLElement).dataset.step;
        if (barStep && nextStepValue !== 'result') {
          bar.classList.toggle('calculator__progress-bar--active', parseInt(barStep) <= parseInt(nextStepValue));
        } else if (nextStepValue === 'result') {
          // If intermediate result, fill 3 steps
          bar.classList.toggle('calculator__progress-bar--active', parseInt(barStep || '0') <= 3);
        }
      });
    }

    let calculatedPrice = '120 lei/oră';
    let calculatedPackage = '';

    function showResult() {
      const materie = state.step1 || 'materie';
      const nivel = state.step2 || 'mediu';
      const timp = state.step3 || 'lung';

      let icon = '🎯';
      let title = '';
      let desc = '';
      
      calculatedPrice = '120 lei/oră';
      calculatedPackage = 'Pachetul 5 Garantat';

      if (timp === 'urgent') {
        icon = '🔥';
        calculatedPackage = 'Modul Pompier';
        calculatedPrice = '150 lei/oră';
        const ore = nivel === 'zero' ? '4-6' : nivel === 'mediu' ? '2-4' : '2-3';
        title = `Modul Pompier — ${ore} ore intensive`;
        desc = `E urgent! Cu ${ore} ore concentrate pe tiparele de subiecte la ${materie}, maximizăm șansele de trecere.`;
      } else if (nivel === 'zero') {
        icon = '📚';
        const ore = timp === 'scurt' ? '6-10' : '10-16';
        title = `Pachetul 5 Garantat — ~${ore} ore`;
        desc = `Plecăm de la zero la ${materie}. În ${ore} ore acoperim bazele și tiparele de examen.`;
      } else if (nivel === 'avansat') {
        icon = '🚀';
        calculatedPackage = 'Modul Prestanță';
        const ore = timp === 'scurt' ? '4-6' : '6-10';
        title = `Modul Prestanță — ~${ore} ore`;
        desc = `Pregătire avansată la ${materie} pentru nota 9-10. Subiecte capcană și exerciții complexe.`;
      } else {
        const ore = timp === 'scurt' ? '4-6' : '6-10';
        title = `${calculatedPackage} — ~${ore} ore`;
        desc = `Ai o bază la ${materie}, ne concentrăm pe exerciții practice.`;
      }

      state.calculatedPackage = calculatedPackage;
      state.calculatedPrice = calculatedPrice;

      const iconEl = document.getElementById('calc-result-icon');
      const titleEl = document.getElementById('calc-result-title');
      const descEl = document.getElementById('calc-result-desc');
      const priceLabelEl = document.getElementById('calc-result-price-label');
      const acordLabel = document.getElementById('label-acord-pret');

      if (iconEl) iconEl.textContent = icon;
      if (titleEl) titleEl.textContent = title;
      if (descEl) descEl.textContent = desc;
      if (priceLabelEl) priceLabelEl.textContent = `Tarif: ${calculatedPrice}`;
      if (acordLabel) acordLabel.textContent = `Sunt de acord cu tariful de ${calculatedPrice} (plata se face după ședință).`;
    }

    // Continue to Funnel Form (Step 4)
    document.getElementById('btn-continue-form')?.addEventListener('click', () => {
      const resultStep = wizard.querySelector('.calculator__step[data-step="result"]') as HTMLElement;
      goToStep(resultStep, '4');
    });

    // Step 4 to Step 5
    document.getElementById('btn-to-step5')?.addEventListener('click', () => {
      let fac = (document.getElementById('f_facultate') as HTMLSelectElement).value;
      if (fac === 'Alta') {
        fac = (document.getElementById('f_facultate_other') as HTMLInputElement).value;
      }
      const an = (document.getElementById('f_an') as HTMLSelectElement).value;
      const subiecte = (document.querySelector('input[name="f_subiecte"]:checked') as HTMLInputElement)?.value;
      const acordOnline = (document.getElementById('f_acord_online') as HTMLInputElement).checked;
      const acord = (document.getElementById('f_acord_pret') as HTMLInputElement).checked;

      const errorEl = document.getElementById('error-step4');
      if (errorEl) {
        errorEl.style.display = 'none';
        errorEl.textContent = '';
      }

      if (!fac || !an || !subiecte) {
        if (errorEl) { errorEl.textContent = 'Te rog să completezi toate câmpurile (facultate, an, subiecte).'; errorEl.style.display = 'block'; }
        return;
      }
      if (!acordOnline) {
        if (errorEl) { errorEl.textContent = 'Trebuie să confirmi că ești de acord cu desfășurarea meditațiilor exclusiv online.'; errorEl.style.display = 'block'; }
        return;
      }
      if (!acord) {
        if (errorEl) { errorEl.textContent = 'Trebuie să fii de acord cu tariful pentru a continua.'; errorEl.style.display = 'block'; }
        return;
      }

      state.facultate = fac;
      state.an = an;
      state.subiecte = subiecte;
      state.acordPret = 'Da';

      const step4 = wizard.querySelector('.calculator__step[data-step="4"]') as HTMLElement;
      goToStep(step4, '5');
    });

    // Submit Webhook & Redirect
    document.getElementById('btn-submit-funnel')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      const nume = (document.getElementById('f_nume') as HTMLInputElement).value;
      const telefon = (document.getElementById('f_telefon') as HTMLInputElement).value;
      
      const honeypot = (document.getElementById('b_website') as HTMLInputElement).value;
      const mentiuni = (document.getElementById('f_mentiuni') as HTMLTextAreaElement)?.value || '';
      const email = (document.getElementById('f_email') as HTMLInputElement)?.value || '';
      const newsletter = (document.getElementById('f_newsletter') as HTMLInputElement)?.checked ? 'Da' : 'Nu';
      const acordLegal = (document.getElementById('f_acord_legal') as HTMLInputElement)?.checked ? 'Da' : 'Nu';

      const rawData = {
        materie: state.step1,
        nivel_initial: state.step2,
        timp_ramas: state.step3,
        pachet_recomandat: state.calculatedPackage,
        pret: state.calculatedPrice,
        facultate: state.facultate,
        an: state.an,
        are_subiecte: state.subiecte,
        nume: nume,
        telefon: telefon,
        email: email,
        newsletter: newsletter,
        mentiuni: mentiuni,
        sursa: window.location.href,
        b_website: honeypot,
        loadTime: loadTime,
        acord_legal: acordLegal
      };

      const result = formSchema.safeParse(rawData);
      
      // Clear all field errors first
      ['nume', 'telefon', 'email', 'acord_legal'].forEach(id => {
        const el = document.getElementById('error-f_' + id);
        if (el) { el.style.display = 'none'; el.innerHTML = ''; }
      });

      const errorEl = document.getElementById('error-step5');
      if (errorEl) {
        errorEl.style.display = 'none';
        errorEl.innerHTML = '';
      }

      if (!result.success) {
        let hasGlobalError = false;
        result.error.issues.forEach(issue => {
           const fieldName = issue.path[0];
           const fieldErrorEl = document.getElementById('error-f_' + fieldName);
           
           if (fieldErrorEl) {
             // If multiple issues for the same field, append them
             if (fieldErrorEl.innerHTML !== '') fieldErrorEl.innerHTML += '<br/>';
             fieldErrorEl.innerHTML += issue.message;
             fieldErrorEl.style.display = 'block';
           } else {
             hasGlobalError = true;
             if (errorEl) {
                if (errorEl.innerHTML !== '') errorEl.innerHTML += '<br/>';
                errorEl.innerHTML += issue.message;
             }
           }
        });
        
        if (hasGlobalError && errorEl) {
           errorEl.style.display = 'block';
        }
        return;
      }

      // Disable button
      // Loading state
      const ogText = btn.innerHTML;
      btn.innerHTML = 'Se trimite...';
      btn.disabled = true;
      const payload = result.data;

      // Apelăm endpoint-ul nostru de Astro SSR
      try {
        await fetch('/api/submit-lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
      } catch (err) {
        console.error('API Route error:', err);
      }

      // Generate WhatsApp message
      let msg = `Salut! Sunt ${payload.nume}, anul ${payload.an} la ${payload.facultate}.\n\nAm făcut formularul pe site și aș vrea ${payload.pachet_recomandat} la ${payload.materie}.\nTarif acceptat: ${payload.pret}.\n\n`;
      if (mentiuni.trim()) {
        msg += `Mențiuni suplimentare: ${mentiuni.trim()}\n\n`;
      }
      msg += `Când am putea începe?`;
      const encodedMsg = encodeURIComponent(msg);
      const waUrl = `https://wa.me/${document.getElementById('calculator').dataset.waNumber}?text=${encodedMsg}`;

      // Open WhatsApp in new tab and redirect to Thank You page
      window.open(waUrl, '_blank');
      window.location.href = '/multumim';
      
      // Reset after a delay (in case redirect is blocked)
      setTimeout(() => {
        btn.innerHTML = ogText;
        btn.disabled = false;
      }, 3000);
    });

    // Reset Flow
    document.getElementById('calc-reset')?.addEventListener('click', () => {
      Object.keys(state).forEach(k => delete state[k]);
      wizard.querySelectorAll('.calculator__step').forEach(s => s.classList.remove('calculator__step--active'));
      wizard.querySelector('.calculator__step[data-step="1"]')?.classList.add('calculator__step--active');
      wizard.querySelectorAll('.calculator__option').forEach(o => o.classList.remove('calculator__option--selected'));
      wizard.querySelectorAll('.calculator__progress-bar').forEach((bar, i) => {
        bar.classList.toggle('calculator__progress-bar--active', i === 0);
      });
      
      // Reset inputs
      (document.getElementById('f_nume') as HTMLInputElement).value = '';
      (document.getElementById('f_telefon') as HTMLInputElement).value = '';
      (document.getElementById('f_email') as HTMLInputElement).value = '';
      (document.getElementById('f_newsletter') as HTMLInputElement).checked = false;
      (document.getElementById('f_facultate') as HTMLSelectElement).value = '';
      (document.getElementById('f_facultate_other') as HTMLInputElement).value = '';
      (document.getElementById('f_facultate_other') as HTMLInputElement).style.display = 'none';
      (document.getElementById('f_an') as HTMLSelectElement).value = '';
      (document.getElementById('f_acord_online') as HTMLInputElement).checked = false;
      (document.getElementById('f_acord_pret') as HTMLInputElement).checked = false;
      const mentiuniEl = document.getElementById('f_mentiuni') as HTMLTextAreaElement;
      if (mentiuniEl) mentiuniEl.value = '';
      const radios = document.querySelectorAll('input[name="f_subiecte"]') as NodeListOf<HTMLInputElement>;
      radios.forEach(r => r.checked = false);
    });
  }
</script>
