---

<div class="blackboard-wrapper" id="blackboard-wrapper">
  <!-- Fundalul fix din spate (culoarea site-ului, tabla curata) -->
  <div class="board-back">
    <div class="board-back-content">
      <img src="/problema de mecanica 2 cinematica.webp" class="chalk-img clean-img" alt="Solutie" />
    </div>
  </div>

  <!-- Tabla din față (care culisează) -->
  <div class="board-front" id="board-front">
    <div class="board-front-surface">
      <img src="/problema de cinematica mecanica 2.webp" class="chalk-img messy-img-1" alt="Formule amestecate" />
      <img src="/constructie piramida.webp" class="chalk-img messy-img-2" alt="Mai multe formule" />
    </div>
  </div>
</div>

<style>
  .blackboard-wrapper {
    position: relative;
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    aspect-ratio: 1.2;
    overflow: hidden;
    border-radius: 12px;
    /* Cadru metalic 3D realist creat doar din CSS */
    background-color: #0f172a; /* Culoarea de fundal a tablei */
    border: 16px solid #b0b5b9;
    border-top-color: #d1d5db;
    border-bottom-color: #8a9196;
    border-left-color: #a0a6ab;
    border-right-color: #a0a6ab;
    box-shadow: 
      0 30px 60px rgba(0, 0, 0, 0.6),
      inset 0 10px 20px rgba(0, 0, 0, 0.5),
      inset 0 -5px 15px rgba(0,0,0,0.4);
  }

  .board-back {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    /* Adăugăm o textură de praf de cretă extrem de subtilă */
    background-image: 
      radial-gradient(circle at 30% 40%, rgba(255,255,255,0.02) 0%, transparent 20%),
      radial-gradient(circle at 70% 60%, rgba(255,255,255,0.015) 0%, transparent 25%);
  }

  .board-back-content {
    position: absolute;
    top: 5%;
    left: 5%;
    width: 90%;
    height: 45%;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Efectul de cretă ultra-realist pe poze alb-negru */
  .chalk-img {
    filter: drop-shadow(0 0 2px rgba(255,255,255,0.3)) grayscale(1) invert(1) contrast(3) brightness(1.2) sepia(0.2) hue-rotate(180deg);
    mix-blend-mode: plus-lighter;
    opacity: 0.85;
    pointer-events: none;
  }

  .clean-img {
    max-height: 90%;
    max-width: 90%;
    object-fit: contain;
  }

  /* Tabla din față care se mișcă */
  .board-front {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 52%; /* Acoperă jumătatea de sus */
    z-index: 3;
    will-change: transform;
    transform: translateY(0);
    
    /* Fundalul tablei glisante (aceeași nuanță cu tabla de jos) */
    background-color: #121c33;
    background-image: 
      radial-gradient(circle at 20% 80%, rgba(255,255,255,0.015) 0%, transparent 30%),
      radial-gradient(circle at 80% 20%, rgba(255,255,255,0.02) 0%, transparent 20%);
    
    /* Marginea de metal de jos care glisează */
    border-bottom: 12px solid #aeb4b8;
    box-shadow: 
      inset 0 0 40px rgba(0,0,0,0.6), 
      0 12px 20px rgba(0,0,0,0.5); /* Umbra pe care o aruncă peste tabla de jos */
  }

  .board-front-surface {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .messy-img-1 {
    position: absolute;
    top: 0;
    left: 5%;
    width: 65%;
    transform: rotate(-3deg);
  }

  .messy-img-2 {
    position: absolute;
    bottom: -15%;
    right: 2%;
    width: 50%;
    transform: rotate(6deg);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const wrapper = document.getElementById('blackboard-wrapper');
    const boardFront = document.getElementById('board-front');
    if (!wrapper || !boardFront) return;

    window.addEventListener('scroll', () => {
      const rect = wrapper.getBoundingClientRect();
      const windowHeight = window.innerHeight;
      
      if (rect.top < windowHeight && rect.bottom > 0) {
        const progress = Math.max(0, Math.min(1, (windowHeight * 0.8 - rect.top) / windowHeight));
        const slideAmount = (progress * progress) * 150; 
        
        // Culisăm până aproape de marginea de jos
        const clampedSlide = Math.min(slideAmount, 92); 
        
        boardFront.style.transform = `translateY(${clampedSlide}%)`;
      }
    }, { passive: true });
  });
</script>
