<div class="blackboard-wrapper" id="blackboard-wrapper">
  
  <!-- Tabla curată (inițial jos) care va urca -->
  <div class="board-clean" id="board-clean">
    <div class="board-surface">
      <img src="/problema de mecanica 2 cinematica.webp" class="chalk-img clean-img-1" alt="Solutie 1" />
      <img src="/sectiune con.webp" class="chalk-img clean-img-2" alt="Solutie 2" />
    </div>
  </div>

  <!-- Tabla dezordonată (inițial sus) care va coborî și se va clarifica -->
  <div class="board-messy" id="board-messy">
    <div class="board-surface">
      <img src="/problema de cinematica mecanica 2.webp" class="chalk-img messy-img messy-img-1" alt="Formule amestecate 1" />
      <img src="/constructie piramida.webp" class="chalk-img messy-img messy-img-2" alt="Formule amestecate 2" />
      <img src="/desfasurata cilindru.webp" class="chalk-img messy-img messy-img-3" alt="Formule amestecate 3" />
      <img src="/plan definit de 2 drepte paralele.webp" class="chalk-img messy-img messy-img-4" alt="Formule amestecate 4" />
      <img src="/intersectie tip patrundere.webp" class="chalk-img messy-img messy-img-5" alt="Formule amestecate 5" />
      <img src="/desfasurata con.webp" class="chalk-img messy-img messy-img-6" alt="Formule amestecate 6" />
      <img src="/sectiune cilindru.webp" class="chalk-img messy-img messy-img-7" alt="Formule amestecate 7" />
    </div>
    <div class="board-surface" style="position: absolute; top: 0; left: 0;">
      <!-- Noile poze clare și ordonate care apar după jumătate din animație -->
      <img src="/desfasurata con.webp" class="chalk-img clean-new-img clean-img-1" alt="Solutie noua 1" />
      <img src="/plan definit de 2 drepte paralele.webp" class="chalk-img clean-new-img clean-img-2" alt="Solutie noua 2" />
    </div>
  </div>

</div>

<style>
  .blackboard-wrapper {
    position: relative;
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    aspect-ratio: 1.1;
    overflow: hidden;
    border-radius: 12px;
    /* Cadru metalic realist */
    /* Fundalul transparent ca să se vadă peretele site-ului */
    background-color: transparent; 
    border: 8px solid #b0b5b9;
    border-top-color: #d1d5db;
    border-bottom-color: #8a9196;
    border-left-color: #a0a6ab;
    border-right-color: #a0a6ab;
    box-shadow: 
      0 30px 60px rgba(0, 0, 0, 0.6),
      inset 0 10px 20px rgba(0, 0, 0, 0.5);
  }

  .board-clean, .board-messy {
    position: absolute;
    width: 100%;
    height: 50%; /* Ocupă jumătate din înălțime */
    will-change: transform;
    transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    /* Culoarea tablei */
    background-color: #0f172a;
    background-image: 
      radial-gradient(circle at 20% 80%, rgba(255,255,255,0.015) 0%, transparent 30%),
      radial-gradient(circle at 80% 20%, rgba(255,255,255,0.02) 0%, transparent 20%);
    box-shadow: inset 0 0 30px rgba(0,0,0,0.8);
  }

  .board-clean {
    bottom: 0;
    left: 0;
    z-index: 1; /* Tabla curată stă în spate */
    border-top: 4px solid #aeb4b8; /* Marginea de sus de metal */
    border-bottom: 4px solid #8a9196; /* Marginea de jos de metal */
    transform: translateY(0);
  }

  .board-messy {
    top: 0;
    left: 0;
    z-index: 2; /* Tabla murdară stă în față și se suprapune la trecere */
    border-top: 4px solid #d1d5db; /* Marginea de metal de sus */
    border-bottom: 6px solid #aeb4b8; /* Marginea de metal de jos */
    transform: translateY(0);
    box-shadow: 
      inset 0 0 30px rgba(0,0,0,0.8), 
      0 10px 20px rgba(0,0,0,0.4);
  }

  .board-surface {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  /* Efectul realist de cretă (optimizat pentru a îngroșa și lumina liniile subțiri) */
  .chalk-img {
    filter: blur(0.5px) drop-shadow(0 0 1px rgba(255,255,255,0.4)) drop-shadow(0 0 2px rgba(255,255,255,0.2)) grayscale(1) invert(1) contrast(1.6) brightness(1.6) sepia(0.2) hue-rotate(180deg);
    mix-blend-mode: plus-lighter;
    opacity: 0.85;
    pointer-events: none;
  }

  .messy-img, .clean-new-img {
    transition: opacity 0.3s ease;
  }

  .clean-new-img {
    opacity: 0;
  }

  /* La trecerea de jumătate, ascundem haosul și arătăm claritatea direct pe elemente ca să nu stricăm mix-blend-mode-ul */
  .board-messy.show-clean .messy-img {
    opacity: 0;
  }
  .board-messy.show-clean .clean-new-img {
    opacity: 0.95;
  }

  /* Desenele murdare (mai mici, mai multe, împrăștiate) */
  .messy-img-1 { position: absolute; top: 10%; left: 5%; width: 22%; transform: rotate(-8deg); }
  .messy-img-2 { position: absolute; bottom: 5%; right: 10%; width: 18%; transform: rotate(12deg); }
  .messy-img-3 { position: absolute; top: 15%; right: 5%; width: 20%; transform: rotate(-5deg); }
  .messy-img-4 { position: absolute; bottom: 10%; left: 15%; width: 18%; transform: rotate(7deg); }
  .messy-img-5 { position: absolute; top: 30%; left: 35%; width: 15%; transform: rotate(-15deg); }
  .messy-img-6 { position: absolute; bottom: 20%; left: 45%; width: 17%; transform: rotate(5deg); }
  .messy-img-7 { position: absolute; top: -5%; left: 55%; width: 20%; transform: rotate(-10deg); }

  /* Desenele curate (frumos ordonate pe tabla de jos care va urca) */
  .clean-img-1 { position: absolute; top: 10%; left: 5%; height: 80%; width: 45%; object-fit: contain; }
  .clean-img-2 { position: absolute; top: 10%; right: 5%; height: 80%; width: 45%; object-fit: contain; }

</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const wrapper = document.getElementById('blackboard-wrapper');
    const boardClean = document.getElementById('board-clean');
    const boardMessy = document.getElementById('board-messy');
    
    if (!wrapper || !boardClean || !boardMessy) return;

    window.addEventListener('scroll', () => {
      const scrollY = window.scrollY;
      
      // Culisăm pe baza scroll-ului efectiv. 
      // La scrollY = 0, progresul e 0% (închise complet).
      // Se vor deschide complet după ~400px de scroll.
      const maxScroll = 400; 
      const progress = Math.max(0, Math.min(1, scrollY / maxScroll));
      
      // Ease out
      const slideAmount = progress * 100; 
      
      boardMessy.style.transform = `translateY(${slideAmount}%)`;
      boardClean.style.transform = `translateY(-${slideAmount}%)`;

      // Când trece de jumătate (progress > 0.45), schimbăm pozele dezordonate în unele clare
      if (progress > 0.45) {
        boardMessy.classList.add('show-clean');
      } else {
        boardMessy.classList.remove('show-clean');
      }
    }, { passive: true });
  });
</script>
