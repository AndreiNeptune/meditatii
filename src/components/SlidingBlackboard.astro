<div class="blackboard-wrapper" id="blackboard-wrapper">
  
  <!-- Tabla curată (inițial jos) care va urca -->
  <div class="board-clean" id="board-clean">
    <div class="board-surface">
      <img src="/problema de mecanica 2 cinematica.webp" class="chalk-img clean-img-1" alt="Solutie 1" />
      <img src="/sectiune con.webp" class="chalk-img clean-img-2" alt="Solutie 2" />
    </div>
  </div>

  <!-- Tabla dezordonată (inițial sus) care va coborî -->
  <div class="board-messy" id="board-messy">
    <div class="board-surface">
      <img src="/problema de cinematica mecanica 2.webp" class="chalk-img messy-img-1" alt="Formule amestecate 1" />
      <img src="/constructie piramida.webp" class="chalk-img messy-img-2" alt="Formule amestecate 2" />
      <img src="/desfasurata cilindru.webp" class="chalk-img messy-img-3" alt="Formule amestecate 3" />
      <img src="/plan definit de 2 drepte paralele.webp" class="chalk-img messy-img-4" alt="Formule amestecate 4" />
      <img src="/intersectie tip patrundere.webp" class="chalk-img messy-img-5" alt="Formule amestecate 5" />
    </div>
  </div>

</div>

<style>
  .blackboard-wrapper {
    position: relative;
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    aspect-ratio: 1.1;
    overflow: hidden;
    border-radius: 12px;
    /* Cadru metalic realist */
    /* Fundalul transparent ca să se vadă peretele site-ului */
    background-color: transparent; 
    border: 16px solid #b0b5b9;
    border-top-color: #d1d5db;
    border-bottom-color: #8a9196;
    border-left-color: #a0a6ab;
    border-right-color: #a0a6ab;
    box-shadow: 
      0 30px 60px rgba(0, 0, 0, 0.6),
      inset 0 10px 20px rgba(0, 0, 0, 0.5);
  }

  .board-clean, .board-messy {
    position: absolute;
    width: 100%;
    height: 50%; /* Ocupă jumătate din înălțime */
    will-change: transform;
    /* Culoarea tablei */
    background-color: #0f172a;
    background-image: 
      radial-gradient(circle at 20% 80%, rgba(255,255,255,0.015) 0%, transparent 30%),
      radial-gradient(circle at 80% 20%, rgba(255,255,255,0.02) 0%, transparent 20%);
    box-shadow: inset 0 0 30px rgba(0,0,0,0.8);
  }

  .board-clean {
    bottom: 0;
    left: 0;
    z-index: 1; /* Tabla curată stă în spate */
    border-top: 8px solid #aeb4b8; /* Marginea de sus de metal */
    transform: translateY(0);
  }

  .board-messy {
    top: 0;
    left: 0;
    z-index: 2; /* Tabla murdară stă în față și se suprapune la trecere */
    border-bottom: 12px solid #aeb4b8; /* Marginea de metal de jos */
    transform: translateY(0);
    box-shadow: 
      inset 0 0 30px rgba(0,0,0,0.8), 
      0 10px 20px rgba(0,0,0,0.4);
  }

  .board-surface {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  /* Efectul realist de cretă */
  .chalk-img {
    filter: drop-shadow(0 0 1px rgba(255,255,255,0.1)) grayscale(1) invert(1) contrast(3) brightness(1.2) sepia(0.2) hue-rotate(180deg);
    mix-blend-mode: plus-lighter;
    opacity: 0.85;
    pointer-events: none;
  }

  /* Desenele murdare (mai mici, mai multe, împrăștiate) */
  .messy-img-1 { position: absolute; top: 10%; left: 5%; width: 35%; transform: rotate(-8deg); }
  .messy-img-2 { position: absolute; bottom: 5%; right: 10%; width: 30%; transform: rotate(12deg); }
  .messy-img-3 { position: absolute; top: 15%; right: 5%; width: 35%; transform: rotate(-5deg); }
  .messy-img-4 { position: absolute; bottom: 10%; left: 15%; width: 30%; transform: rotate(7deg); }
  .messy-img-5 { position: absolute; top: 40%; left: 40%; width: 25%; transform: rotate(-15deg); }

  /* Desenele curate (frumos ordonate pe tabla de jos care va urca) */
  .clean-img-1 { position: absolute; top: 10%; left: 5%; height: 80%; width: 45%; object-fit: contain; }
  .clean-img-2 { position: absolute; top: 10%; right: 5%; height: 80%; width: 45%; object-fit: contain; }

</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const wrapper = document.getElementById('blackboard-wrapper');
    const boardClean = document.getElementById('board-clean');
    const boardMessy = document.getElementById('board-messy');
    
    if (!wrapper || !boardClean || !boardMessy) return;

    window.addEventListener('scroll', () => {
      const rect = wrapper.getBoundingClientRect();
      const windowHeight = window.innerHeight;
      
      if (rect.top < windowHeight && rect.bottom > 0) {
        const progress = Math.max(0, Math.min(1, (windowHeight * 0.8 - rect.top) / windowHeight));
        
        // Culisăm pe un interval [0, 100]
        // Tabla murdară coboară (100%)
        // Tabla curată urcă (-100%)
        const slideAmount = (progress * progress) * 150; 
        const clampedSlide = Math.min(slideAmount, 100); 
        
        boardMessy.style.transform = `translateY(${clampedSlide}%)`;
        boardClean.style.transform = `translateY(-${clampedSlide}%)`;
      }
    }, { passive: true });
  });
</script>
