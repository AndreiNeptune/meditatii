<script>
  document.addEventListener('DOMContentLoaded', () => {
    const track = document.querySelector('.testimonials-track') as HTMLElement;
    if (!track) return;

    const originalCount = track.children.length;
    const cards = Array.from(track.children);
    
    // Clone the cards for infinite scroll
    cards.forEach(card => {
      const clone = card.cloneNode(true) as HTMLElement;
      clone.setAttribute('aria-hidden', 'true');
      track.appendChild(clone);
    });

    let isHovered = false;
    let scrollSpeed = 0.5; // adjust for speed

    // Pause on hover
    track.addEventListener('mouseenter', () => isHovered = true);
    track.addEventListener('mouseleave', () => isHovered = false);
    
    // Pause on touch interactions
    track.addEventListener('touchstart', () => isHovered = true, { passive: true });
    track.addEventListener('touchend', () => {
      // Resume after a short delay so manual scroll momentum finishes
      setTimeout(() => isHovered = false, 1000);
    });

    function autoScroll() {
      if (track.children.length > originalCount) {
        if (!isHovered) {
          track.scrollLeft += scrollSpeed;
        }
        
        const firstOriginal = track.children[0] as HTMLElement;
        const firstClone = track.children[originalCount] as HTMLElement;
        const resetPoint = firstClone.offsetLeft - firstOriginal.offsetLeft;
        
        // Infinit scroll către dreapta (inclusiv manual)
        if (track.scrollLeft >= resetPoint) {
          track.scrollLeft -= resetPoint;
        }
        // Infinit scroll către stânga (manual)
        else if (track.scrollLeft <= 0) {
          track.scrollLeft += resetPoint - 1;
        }
      }
      requestAnimationFrame(autoScroll);
    }

    // Start auto-scroll after a short delay to ensure layout is calculated
    setTimeout(() => {
      requestAnimationFrame(autoScroll);
    }, 500);
  });
</script>
