---
---

<section class="lead-form-section reveal">
  <div class="container container--narrow">
    <div class="card card--glow lead-form-card">
      <div class="lead-form__content">
        <h2 class="section__title">Vrei să primești resurse gratuite pentru examene?</h2>
        <p class="section__subtitle" style="margin-bottom: var(--space-lg);">
          Lasă-ne adresa de email și îți trimitem formulare, cheat-sheet-uri (Analiză, Mecanică, GD) și sfaturi care să te scape de restanțe direct în inbox. Fără spam.
        </p>
        
        <form class="lead-form" id="lead-magnet-form" action="#" method="POST" onsubmit="event.preventDefault(); alert('Mulțumim! Te-ai abonat cu succes la resursele gratuite. Vom trimite materiale în curând.'); this.reset();">
          <div class="lead-form__input-group">
            <input 
              type="email" 
              name="email" 
              placeholder="Adresa ta de email" 
              required 
              class="lead-form__input"
            />
            <button type="submit" class="btn btn--primary lead-form__btn">
              Vreau resursele
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
              </svg>
            </button>
          </div>
          <p class="lead-form__privacy">
            *Datele tale sunt în siguranță. Te poți dezabona oricând.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .lead-form-section {
    padding: var(--space-2xl) 0 var(--space-4xl);
  }
  
  .lead-form-card {
    text-align: center;
    background: linear-gradient(135deg, rgba(108, 92, 231, 0.1), rgba(162, 155, 254, 0.05));
    border-color: rgba(108, 92, 231, 0.2);
    padding: var(--space-3xl) var(--space-lg);
  }

  .lead-form__content {
    max-width: 700px;
    margin: 0 auto;
  }
  
  .lead-form__input-group {
    display: flex;
    gap: var(--space-sm);
    max-width: 500px;
    margin: 0 auto;
  }
  
  .lead-form__input {
    flex-grow: 1;
    padding: 1rem 1.5rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-hover);
    background: var(--bg-primary);
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: 1rem;
    outline: none;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }
  
  .lead-form__input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(108, 92, 231, 0.2);
  }
  
  .lead-form__btn {
    border-radius: var(--radius-full);
    padding: 1rem 1.5rem;
  }
  
  .lead-form__privacy {
    margin-top: var(--space-md);
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  
  @media (max-width: 768px) {
    .lead-form__input-group {
      flex-direction: column;
    }
    
    .lead-form__btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
