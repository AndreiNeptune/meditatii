---
---

<div class="lead-form-fixed" id="lead-magnet-bar">
  <div class="container lead-form-fixed__inner">
    <div class="lead-form-fixed__text">
      <strong>Resurse gratuite pentru examene</strong>
      <span>Lasă-ne adresa de email și îți trimitem cheat-sheet-uri pentru Analiză, Mecanică și GD. Fără spam.</span>
    </div>
    
    <form class="lead-form-fixed__form" id="lead-magnet-form" action="#" method="POST" onsubmit="event.preventDefault(); alert('Mulțumim! Te-ai abonat cu succes la resursele gratuite. Vom trimite materiale în curând.'); document.getElementById('lead-magnet-bar').style.display='none';">
      <div class="lead-form__input-group">
        <input 
          type="email" 
          name="email" 
          placeholder="Adresa ta de email" 
          required 
          class="lead-form__input"
        />
        <button type="submit" class="btn btn--primary lead-form__btn">
          Vreau resursele
        </button>
      </div>
    </form>
    
    <button type="button" class="lead-form-fixed__close" aria-label="Închide" onclick="document.getElementById('lead-magnet-bar').style.display='none'">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
  </div>
</div>

<style>
  .lead-form-fixed {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    background: rgba(18, 18, 26, 0.95);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-top: 1px solid var(--border-accent);
    padding: var(--space-md) 0;
    z-index: 995;
    box-shadow: 0 -10px 40px rgba(0,0,0,0.5);
    transform: translateY(150%);
    animation: slideUpBar 0.6s cubic-bezier(0.16, 1, 0.3, 1) 2s forwards;
  }

  @keyframes slideUpBar {
    to { transform: translateY(0); }
  }

  .lead-form-fixed__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
    position: relative;
    padding-right: 40px; /* space for close btn */
  }

  .lead-form-fixed__text {
    flex: 1.2;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .lead-form-fixed__text strong {
    color: var(--text-primary);
    font-size: 1.05rem;
  }

  .lead-form-fixed__text span {
    color: var(--text-secondary);
    font-size: 0.85rem;
    line-height: 1.4;
  }

  .lead-form-fixed__form {
    flex: 1;
    max-width: 450px;
  }

  .lead-form__input-group {
    display: flex;
    gap: var(--space-sm);
  }

  .lead-form__input {
    flex-grow: 1;
    padding: 0.6rem 1.2rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-hover);
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: 0.9rem;
    outline: none;
    transition: all var(--transition-fast);
  }
  
  .lead-form__input:focus {
    border-color: var(--accent);
    background: var(--bg-card);
    box-shadow: 0 0 0 2px rgba(108, 92, 231, 0.2);
  }

  .lead-form__btn {
    padding: 0.6rem 1.2rem;
    font-size: 0.9rem;
  }

  .lead-form-fixed__close {
    position: absolute;
    top: 50%;
    right: var(--space-lg);
    transform: translateY(-50%);
    color: var(--text-muted);
    background: rgba(255,255,255,0.05);
    border: 1px solid var(--border);
    border-radius: 50%;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .lead-form-fixed__close:hover {
    color: var(--text-primary);
    background: rgba(255,255,255,0.1);
  }

  @media (max-width: 900px) {
    .lead-form-fixed__inner {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-md);
      padding-right: var(--space-lg);
    }
    
    .lead-form-fixed__form {
      max-width: 100%;
    }
    
    .lead-form-fixed__close {
      top: -16px;
      right: 16px;
      transform: none;
      background: var(--bg-card);
      border-color: var(--border-accent);
    }
  }

  @media (max-width: 768px) {
    .lead-form-fixed {
      bottom: 60px; /* Sits above the MobileStickyCTA */
      padding: var(--space-md) 0 var(--space-lg);
    }
    
    .lead-form__input-group {
      flex-direction: column;
    }
    
    .lead-form__btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
