---
interface Props {
  size?: number;
  class?: string;
}
const { size = 48, class: className = '' } = Astro.props;
---
<svg class={className} width={size} height={size} viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Set square / triangle ruler for GD -->
  <path d="M6 42L6 6L42 42H6Z" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
  <path d="M6 30L18 30L18 42" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.5"/>
  <!-- Angle arc -->
  <path d="M6 34C10 34 14 36 14 42" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.4"/>
  <!-- Projection lines -->
  <line x1="24" y1="6" x2="24" y2="14" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3 3" opacity="0.3"/>
  <line x1="34" y1="6" x2="34" y2="24" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3 3" opacity="0.3"/>
  <!-- Point markers -->
  <circle cx="24" cy="24" r="2.5" fill="currentColor" opacity="0.7"/>
  <circle cx="14" cy="28" r="1.5" fill="currentColor" opacity="0.4"/>
</svg>
