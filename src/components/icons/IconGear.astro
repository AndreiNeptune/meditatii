---
interface Props {
  size?: number;
  class?: string;
}
const { size = 48, class: className = '' } = Astro.props;
---
<svg class={className} width={size} height={size} viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Gear wheel - Mecanica 2 / Dinamica -->
  <circle cx="24" cy="24" r="8" stroke="currentColor" stroke-width="2.5" fill="none"/>
  <circle cx="24" cy="24" r="3" fill="currentColor" opacity="0.4"/>
  <!-- Gear teeth -->
  <rect x="22" y="4" width="4" height="8" rx="1" fill="currentColor" opacity="0.7"/>
  <rect x="22" y="36" width="4" height="8" rx="1" fill="currentColor" opacity="0.7"/>
  <rect x="4" y="22" width="8" height="4" rx="1" fill="currentColor" opacity="0.7"/>
  <rect x="36" y="22" width="8" height="4" rx="1" fill="currentColor" opacity="0.7"/>
  <!-- Diagonal teeth -->
  <rect x="33" y="7" width="4" height="8" rx="1" fill="currentColor" opacity="0.5" transform="rotate(45 35 11)"/>
  <rect x="7" y="33" width="4" height="8" rx="1" fill="currentColor" opacity="0.5" transform="rotate(45 9 37)"/>
  <rect x="33" y="33" width="4" height="8" rx="1" fill="currentColor" opacity="0.5" transform="rotate(-45 35 37)"/>
  <rect x="7" y="7" width="4" height="8" rx="1" fill="currentColor" opacity="0.5" transform="rotate(-45 9 11)"/>
  <!-- Motion arrow -->
  <path d="M38 8C40 10 42 14 42 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="3 2" opacity="0.4"/>
  <polygon points="42,18 44,14 39,15" fill="currentColor" opacity="0.4"/>
</svg>
