---
interface Props {
  materie?: string;
  waNumber?: string;
}
const { materie = 'o materie de la Poli', waNumber = '40750208299' } = Astro.props;
const encodedMessage = encodeURIComponent(`Salut! Sunt student la Poli și am nevoie de ajutor la ${materie}. Când aveți disponibilitate?`);
const whatsappUrl = `https://wa.me/${waNumber}?text=${encodedMessage}`;
---

<div class="mobile-sticky-cta">
  <div class="mobile-sticky-cta__inner">
    <div class="mobile-sticky-cta__price">
      <span class="mobile-sticky-cta__label">Tarif ședință:</span>
      <span class="mobile-sticky-cta__value">120 lei/h</span>
    </div>
    <a href="/programare" class="btn btn--primary mobile-sticky-cta__btn">
      <svg class="btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line>
      </svg>
      Programează-te
    </a>
  </div>
</div>
