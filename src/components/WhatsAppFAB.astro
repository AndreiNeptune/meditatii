---
interface Props {
  materie?: string;
}
const { materie = 'o materie de la Poli' } = Astro.props;
const encodedMessage = encodeURIComponent(`Salut! Sunt student la Poli și am nevoie de ajutor la ${materie}. Când aveți disponibilitate?`);
const whatsappUrl = `https://wa.me/NUMAR_TAU?text=${encodedMessage}`;
---

<div class="whatsapp-fab" id="whatsapp-fab">
  <span class="whatsapp-fab__tooltip">💬 Contactează-ne pe WhatsApp!</span>
  <a href={whatsappUrl} target="_blank" rel="noopener" class="whatsapp-fab__btn" aria-label="Contactează pe WhatsApp">
    <svg viewBox="0 0 24 24" fill="currentColor">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
      <path d="M12 0C5.373 0 0 5.373 0 12c0 2.126.553 4.126 1.52 5.867L.057 23.306a.75.75 0 0 0 .92.92l5.44-1.463A11.944 11.944 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.75c-1.875 0-3.654-.516-5.197-1.477l-.363-.215-3.762 1.011 1.011-3.762-.235-.374A9.698 9.698 0 0 1 2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75z"/>
