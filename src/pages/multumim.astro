---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Mulțumim! | Meditații Poli"
  description="Formularul a fost trimis cu succes."
>
  <section class="hero" style="min-height: 70vh; display: flex; align-items: center; justify-content: center; text-align: center;">
    <div class="container">
      <div style="width: 80px; height: 80px; background: rgba(0,200,83,0.1); color: #00c853; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 2rem;">
        <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>
      <h1 class="hero__title" style="font-size: 2.5rem; margin-bottom: 1rem;">Cererea a fost trimisă!</h1>
      <p class="hero__subtitle" style="max-width: 500px; margin: 0 auto 2rem;">
        Am primit detaliile tale. Te vom contacta pe WhatsApp în cel mai scurt timp pentru a stabili prima ședință.
      </p>
      <a href="/" class="btn btn--primary">← Înapoi pe site</a>
    </div>
  </section>
</BaseLayout>
