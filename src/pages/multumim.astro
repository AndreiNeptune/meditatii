---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Mulțumim! | Meditații Poli"
  description="Formularul a fost trimis cu succes."
>
  <section class="hero" style="min-height: 70vh; display: flex; align-items: center; justify-content: center; text-align: center;">
    <div class="container">
      <div style="width: 80px; height: 80px; background: rgba(0,200,83,0.1); color: #00c853; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 2rem;">
        <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>
      <h1 class="hero__title" style="font-size: 2.5rem; margin-bottom: 1rem;">Cererea a fost trimisă!</h1>
      <p class="hero__subtitle" style="max-width: 500px; margin: 0 auto 2rem;">
        Te vom redirecționa către WhatsApp în câteva secunde pentru a trimite mesajul generat. Dacă nu se deschide automat, apasă butonul de mai jos.
      </p>
      <div class="hero__actions" style="justify-content: center; flex-direction: column; align-items: center;">
        <a href="#" id="wa-redirect-btn" class="btn btn--whatsapp" style="display: none; margin-bottom: 1rem;">
          <svg class="btn__icon" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.126.553 4.126 1.52 5.867L.057 23.306a.75.75 0 0 0 .92.92l5.44-1.463A11.944 11.944 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.75c-1.875 0-3.654-.516-5.197-1.477l-.363-.215-3.762 1.011 1.011-3.762-.235-.374A9.698 9.698 0 0 1 2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75z"/></svg>
          Deschide WhatsApp Acum
        </a>
        <a href="/" class="btn btn--outline" style="border: none;">← Înapoi pe site</a>
      </div>
    </div>
  </section>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const params = new URLSearchParams(window.location.search);
      const redirect = params.get('redirect');
      const btn = document.getElementById('wa-redirect-btn');
      
      if (redirect) {
        if (btn) {
          btn.setAttribute('href', redirect);
          btn.style.display = 'inline-flex';
        }
        
        // Auto redirect after a short delay
        setTimeout(() => {
          window.location.href = redirect;
        }, 1500);
      }
    });
  </script>
</BaseLayout>
