---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Programează o ședință | Meditații Poli"
  description="Completează formularul pentru a programa o ședință de meditații."
>
  <div class="container section" style="max-width: 600px; padding-top: 120px;">
    <h1 class="section__title" style="text-align: center;">Programează o ședință</h1>
    <p class="section__subtitle" style="text-align: center; margin-bottom: var(--space-2xl);">
      Completează detaliile de mai jos și te vom contacta în cel mai scurt timp pentru a stabili detaliile.
    </p>

    <div class="card card--glow">
      <form class="contact-form" action="https://formspree.io/f/my-form-id" method="POST" onsubmit="event.preventDefault(); window.location.href='/multumim';">
        <div class="form-group">
          <label for="name">Numele tău</label>
          <input type="text" id="name" name="name" required placeholder="Ex: Andrei Popescu" />
        </div>
        
        <div class="form-group">
          <label for="phone">Număr de telefon (WhatsApp)</label>
          <input type="tel" id="phone" name="phone" required placeholder="Ex: 07XX XXX XXX" />
        </div>
        
        <div class="form-group">
          <label for="subject">La ce materie ai nevoie de ajutor?</label>
          <select id="subject" name="subject" required>
            <option value="" disabled selected>Alege materia...</option>
            <option value="Analiză Matematică">Analiză Matematică</option>
            <option value="Geometrie Descriptivă">Geometrie Descriptivă</option>
            <option value="Mecanică 1 (Statică)">Mecanică 1 (Statică)</option>
            <option value="Mecanică 2 (Dinamică)">Mecanică 2 (Dinamică)</option>
            <option value="Desen Tehnic">Desen Tehnic</option>
            <option value="Altele">Altele</option>
          </select>
        </div>

        <div class="form-group">
          <label for="message">Detalii suplimentare (opțional)</label>
          <textarea id="message" name="message" rows="4" placeholder="Ex: Am examen joi și aș avea nevoie de 2 ședințe..."></textarea>
        </div>

        <button type="submit" class="btn btn--primary" style="width: 100%; justify-content: center; margin-top: var(--space-md);">
          Trimite solicitarea
        </button>
      </form>
    </div>
  </div>
</BaseLayout>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-group label {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-secondary);
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 12px 16px;
    background: var(--bg-primary);
    border: 1px solid var(--border-hover);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font-family: inherit;
    font-size: 1rem;
    transition: all var(--transition-fast);
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 2px rgba(108, 92, 231, 0.2);
  }

  .form-group select {
    appearance: none;
    background-image: url("data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2224%22%20height%3D%2224%22%20viewBox%3D%220%200%24%2024%22%20fill%3D%22none%22%20stroke%3D%22%23a29bfe%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpolyline%20points%3D%226%209%2012%2015%2018%209%22%3E%3C%2Fpolyline%3E%3C%2Fsvg%3E");
    background-repeat: no-repeat;
    background-position: right 12px center;
    background-size: 16px;
  }
</style>
