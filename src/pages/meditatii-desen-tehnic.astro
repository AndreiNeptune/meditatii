---
import BaseLayout from '../layouts/BaseLayout.astro';
import IconRuler from '../components/icons/IconRuler.astro';
import FAQ from '../components/FAQ.astro';
const waNumber = import.meta.env.WHATSAPP_NUMBER || '40750208299';
---
<BaseLayout
  title="Meditații Desen Tehnic Industrial Politehnică | Ajutor Planșe"
  description="Învață regulile de Desen Tehnic pentru proiectele de la Poli! Vederi, secțiuni, cotare, toleranțe și asamblări. 120 lei/oră."
  currentPage="/meditatii-desen-tehnic"
  whatsappMaterie="Desen Tehnic Industrial"
>

  <section class="hero hero--subject">
    <div class="hero__grid"></div>
    <div class="container">
      <div class="hero__content">
        <IconRuler class="hero__icon" size={64} />
        <p class="hero__pretitle">Desen Tehnic Industrial</p>
        <h1 class="hero__title">Planșe corecte, <span>fără nopți nedormite</span></h1>
        <p class="hero__subtitle">
          La facultate regulile de cotare, secțiunile și toleranțele par infinite. La meditații <strong>te ajutăm să înțelegi logica din spate și cum să trasezi liniile corect</strong>. Nu vei mai ghici unde e linie continuă sau întreruptă — vei ști exact de ce o pui acolo.
        </p>
        <div class="hero__actions">
          <a href="/programare" class="btn btn--primary">
            <svg class="btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            Programează o ședință
          </a>
        </div>
        <p class="hero__micro">120 lei/oră • 150 lei/oră urgențe</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="reveal">
        <p class="section__pretitle">Ce abordăm la Desen Tehnic</p>
        <h2 class="section__title">Respecți standardele ISO/SR și înțelegi ce desenezi</h2>
      </div>

      <div class="topic reveal">
        <div class="topic__icon-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="12" y1="3" x2="12" y2="21"/><line x1="3" y1="12" x2="21" y2="12"/></svg></div>
        <div class="topic__content">
          <h3 class="topic__title">1. Reprezentarea în Proiecție Ortogonală</h3>
          <div class="topic__list">
            <div class="topic__item">Alegerea vederii principale și dispunerea vederilor pe formatul A4/A3.</div>
            <div class="topic__item">Linii standardizate (continue, întrerupte, punct-linie) și utilizarea lor corectă.</div>
          </div>
        </div>
      </div>

      <div class="topic reveal">
        <div class="topic__icon-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><line x1="8" y1="13" x2="16" y2="13"/></svg></div>
        <div class="topic__content">
          <h3 class="topic__title">2. Secțiuni și Rupturi</h3>
          <div class="topic__list">
            <div class="topic__item">Cum "tăiem" piesele corect (secțiuni simple, în trepte, parțiale).</div>
            <div class="topic__item">Hașurarea corectă — ce se secționează și ce NU (șuruburi, axe, nervuri).</div>
          </div>
        </div>
      </div>

      <div class="topic reveal">
        <div class="topic__icon-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></div>
        <div class="topic__content">
          <h3 class="topic__title">3. Cotarea (Dimensionarea)</h3>
          <div class="topic__list">
            <div class="topic__item">Reguli de cotare funcțională, tehnologică și de verificare.</div>
            <div class="topic__item">Simboluri specifice (diametre, raze, filete, conicități).</div>
            <div class="topic__item">Evitarea supracotării sau a cotelor lipsă.</div>
          </div>
        </div>
      </div>

      <div class="topic reveal">
        <div class="topic__icon-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.32 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></div>
        <div class="topic__content">
          <h3 class="topic__title">4. Toleranțe și Starea Suprafețelor</h3>
          <div class="topic__list">
            <div class="topic__item">Abateri limită, ajustaje (joc, strângere, tranziție) și sistemul ISO de toleranțe.</div>
            <div class="topic__item">Simbolizarea rugozității și toleranțe geometrice (formă, orientare, bătaie).</div>
          </div>
        </div>
      </div>

      <div class="topic reveal">
        <div class="topic__icon-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg></div>
        <div class="topic__content">
          <h3 class="topic__title">5. Organe de Mașini și Asamblări</h3>
          <div class="topic__list">
            <div class="topic__item">Reprezentarea corectă a filetelor (exterior, interior, în asamblare).</div>
            <div class="topic__item">Asamblări prin filet, pană, caneluri, rulmenți și roți dințate.</div>
            <div class="topic__item">Desen de Ansamblu vs. Desen de Execuție (extragerea pieselor).</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--bg-secondary);">
    <div class="container">
      <div class="solution-box reveal">
        <svg class="solution-box__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/></svg>
        <div>
          <h3 style="margin-bottom: 0.5rem;">Ajutor la Proiecte (Desen de mână sau CAD)</h3>
          <p>Majoritatea notelor vin din predarea planșelor. Te ajutăm pas cu pas să îți gândești planșele și verificăm împreună erorile de cotare înainte să le prezinți profului. Nu lăsa toate planșele pe ultima săptămână!</p>
        </div>
      </div>
    </div>
  </section>

  <div class="reveal"><FAQ /></div>

  <section class="cta-section reveal">
    <div class="container">
      <h2 class="cta-section__title">Nu știi cum să cotezi piesa sau cum să faci secțiunea?</h2>
      <p class="cta-section__desc section__subtitle">Trimite-ne pe WhatsApp o poză și îți explicăm logica din spate.</p>
      <a href="/programare" class="btn btn--primary">
            <svg class="btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            Programează o ședință
          </a>
    </div>
  </section>

</BaseLayout>
