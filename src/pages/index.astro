---
import BaseLayout from '../layouts/BaseLayout.astro';
import IconCompass from '../components/icons/IconCompass.astro';
import IconGraph from '../components/icons/IconGraph.astro';
import IconBeam from '../components/icons/IconBeam.astro';
import IconGear from '../components/icons/IconGear.astro';
import IconRuler from '../components/icons/IconRuler.astro';
import Calculator from '../components/Calculator.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import SlidingBlackboard from '../components/SlidingBlackboard.astro';
const waNumber = import.meta.env.WHATSAPP_NUMBER || '40750208299';
---
<BaseLayout
  title="Meditații UNSTPB București | Treci Examenele de Anul 1 și 2"
  description="Meditații online și fizic pentru studenții Politehnicii (UNSTPB). GD, Analiză Matematică, Mecanică și Desen Tehnic. 120 lei/oră. Scrie pe WhatsApp!"
  whatsappMaterie="o materie de la Poli"
>

  <!-- ═══ HERO ═══ -->
  <section class="hero" id="hero">
    <div class="hero__grid"></div>
    <div class="container hero__split">
      <div class="hero__content">
        <p class="hero__pretitle">
          <svg width="20" height="20" viewBox="0 0 32 32" fill="none" style="flex-shrink: 0; margin-bottom: 2px;">
            <rect x="2" y="2" width="28" height="28" rx="6" stroke="currentColor" stroke-width="2.5"/>
            <path d="M8 24L8 8L24 24H8Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" fill="currentColor" opacity="0.15"/>
            <circle cx="16" cy="16" r="2.5" fill="currentColor"/>
          </svg>
          Exclusiv studenților Politehnicii
        </p>
        <h1 class="hero__title">
          Nu mai lăsa examenele din primii ani <span>să te bage în toamnă</span>
        </h1>
        <p class="hero__subtitle">
          Geometrie Descriptivă, Analiză, Mecanică și Desen Tehnic — explicate pe limba ta, nu a profilor. Fie că ești la zero sau vrei bursă, te ajutăm să înțelegi logica, nu să tocești.<br/><br/>
          <strong class="hero__slogan">Ai prestanță și fără restanță!</strong>
        </p>
        <div class="hero__actions">
          <a href="/programare" class="btn btn--primary">
            <svg class="btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            Programează o ședință
          </a>
          <a href="#calculator" class="btn btn--primary">
            Calculează tariful →
          </a>
        </div>
        <p class="hero__micro">120 lei/oră • Răspundem în maxim 2 ore</p>
        <div class="hero__badges">
          <span class="badge badge--accent">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="18" rx="3"/><line x1="2" y1="9" x2="22" y2="9"/></svg>
            Online (Discord / Meet)
          </span>
          <span class="badge badge--accent">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            Orar flexibil (inclusiv weekend)
          </span>
          <span class="badge badge--green">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            FIMM, ETTI, Transporturi, Energetică, SIM
          </span>
        </div>
      </div>
      <div class="hero__visual">
        <SlidingBlackboard />
      </div>
    </div>
  </section>

  <style>
    .hero__split {
      display: flex;
      flex-direction: column;
      /* Am scos position: relative ca să putem poziționa tabla absolut față de tot ecranul (secțiunea hero) */
      justify-content: center;
      min-height: 80vh;
    }
    .hero__content {
      position: relative;
      z-index: 2;
      /* Eliminat shadow pe text la cerere */
    }
    .hero__visual {
      position: absolute;
      top: 75px; /* Începe fix sub bara de navigație (navbar) */
      left: 50%;
      transform: translateX(-50%);
      width: 100%; 
      max-width: 100%;
      z-index: 0;
      opacity: 0.3; /* Ajustat pentru a compensa lipsa brightness(0.6) */
      pointer-events: none; 
    }
    .hero__visual::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom, transparent 60%, var(--bg-primary) 95%);
      pointer-events: none;
      z-index: 10;
    }
    
    @media (min-width: 1024px) {
      .hero__split {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        gap: 3rem;
        min-height: auto;
      }
      .hero__content {
        flex: 1;
        max-width: 55%;
      }
      .hero__visual {
        flex: 1;
        position: relative;
        top: auto;
        left: auto;
        transform: none;
        width: 100%;
        max-width: 45%;
        opacity: 1;
        filter: none; /* Revenim la luminozitatea normală pe ecran mare */
        pointer-events: auto;
      }
      .hero__visual::after {
        display: none;
      }
    }
  </style>

  <!-- ═══ MATERII ═══ -->
  <section class="section" id="materii">
    <div class="container">
      <div class="reveal">
        <p class="section__pretitle">Ce materii predăm</p>
        <h2 class="section__title">Alege materia la care ai nevoie de ajutor</h2>
      </div>
      <div class="subjects-grid">
        <a href="/meditatii-geometrie-descriptiva" class="subject-card card card--glow reveal">
          <IconCompass class="subject-card__icon" size={48} />
          <h3 class="subject-card__title">Geometrie Descriptivă (GD)</h3>
          <p class="subject-card__desc">Epure, intersecții de corpuri, desfășurări și secțiuni plane. Înțelegi pașii de execuție pas cu pas.</p>
          <span class="subject-card__arrow">Vezi detalii →</span>
        </a>
        <a href="/meditatii-analiza-matematica" class="subject-card card card--glow reveal">
          <IconGraph class="subject-card__icon" size={48} />
          <h3 class="subject-card__title">Analiză Matematică 1</h3>
          <p class="subject-card__desc">Șiruri, serii, derivate parțiale, integrale improprii și ecuații diferențiale. Focus pe exerciții.</p>
          <span class="subject-card__arrow">Vezi detalii →</span>
        </a>
        <a href="/meditatii-mecanica-1" class="subject-card card card--glow reveal">
          <IconBeam class="subject-card__icon" size={48} />
          <h3 class="subject-card__title">Mecanică 1 (Statică)</h3>
          <p class="subject-card__desc">Grinzi cu zăbrele, centre de masă, mișcarea punctului și a rigidului. Rezolvăm exerciții.</p>
          <span class="subject-card__arrow">Vezi detalii →</span>
        </a>
        <a href="/meditatii-mecanica-2" class="subject-card card card--glow reveal">
          <IconGear class="subject-card__icon" size={48} />
          <h3 class="subject-card__title">Mecanică 2 (Dinamică)</h3>
          <p class="subject-card__desc">Teoremele generale și ecuațiile lui Lagrange de speța a II-a. Facem exerciții la greu.</p>
          <span class="subject-card__arrow">Vezi detalii →</span>
        </a>
        <a href="/meditatii-desen-tehnic" class="subject-card card card--glow reveal">
          <IconRuler class="subject-card__icon" size={48} />
          <h3 class="subject-card__title">Desen Tehnic Industrial</h3>
          <p class="subject-card__desc">Vederi, secțiuni, cotare, toleranțe și ansambluri. Înțelegi logica din spate și trasezi corect.</p>
          <span class="subject-card__arrow">Vezi detalii →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ PAIN POINTS ═══ -->
  <section class="section" id="de-ce" style="background: var(--bg-secondary);">
    <div class="container">
      <div class="reveal" style="text-align: center;">
        <p class="section__pretitle">Problema reală</p>
        <h2 class="section__title">Știm amândoi cum e la Poli...</h2>
        <p class="section__subtitle" style="margin-left:auto;margin-right:auto;">Te uiți la curs și simți că se vorbește în chineză? Nu ești singurul.</p>
      </div>
      <div class="pain-grid">
        <div class="pain-card card reveal">
          <svg class="pain-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 8v4M12 16h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/></svg>
          <div class="pain-card__content">
            <h3 class="pain-card__title">Teorie multă, practică puțină</h3>
            <p class="pain-card__desc">Ți se aruncă teoreme și proiecții la cap, dar la examen îți pică exerciții pe care nu le-ai mai văzut niciodată.</p>
          </div>
        </div>
        <div class="pain-card card reveal">
          <svg class="pain-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
          <div class="pain-card__content">
            <h3 class="pain-card__title">Teme și planșe imposibile</h3>
            <p class="pain-card__desc">Primești un proiect la Desen sau o epură la GD și nu ai absolut nicio explicație de unde să începi.</p>
          </div>
        </div>
        <div class="pain-card card reveal">
          <svg class="pain-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <div class="pain-card__content">
            <h3 class="pain-card__title">Timpul scurt</h3>
            <p class="pain-card__desc">Nu ai timp să descifrezi singur cursurile stufoase între laboratoare, proiecte și restul materiilor.</p>
          </div>
        </div>
      </div>
      <div class="solution-box reveal">
        <svg class="solution-box__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <div>
          <h3 style="margin-bottom: 0.5rem;">Soluția: Traduc limbajul academic în exerciții practice</h3>
          <p>Nu predăm teorie abstractă. Ne concentrăm pe ce se dă efectiv la examen: tipare de subiecte, pași de rezolvare clari și exerciții rezolvate cap-coadă, pe înțelesul tău.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ PACHETE ═══ -->
  <section class="section" id="pachete">
    <div class="container">
      <div class="reveal" style="text-align: center;">
        <p class="section__pretitle">Cum te ajutăm</p>
        <h2 class="section__title">Alege modul de pregătire</h2>
      </div>
      <div class="packages-grid">
        <div class="package-card card card--urgent reveal">
          <div class="package-card__emoji">🔥</div>
          <h3 class="package-card__name">Modul Pompier</h3>
          <div class="package-card__price">150 lei <span>/ oră</span></div>
          <p class="package-card__desc">Sub 72h până la examen? Recapitulăm exclusiv tiparele care pică sigur (Regula 80/20).</p>
          <div class="package-card__features">
            <div class="package-card__feature">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              Focus pe exercițiile cu probabilitate maximă
            </div>
            <div class="package-card__feature">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              Ședințe intensive de 2-3 ore
            </div>
            <div class="package-card__feature">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              Obiectiv: Nota 5 garantată
            </div>
          </div>
          <a href={`https://wa.me/${waNumber}?text=Salut!%20Am%20examen%20în%20mai%20puțin%20de%2072h%20și%20am%20nevoie%20de%20Modul%20Pompier.%20Când%20puteți?`} target="_blank" rel="noopener" class="btn btn--warm">Contactează-ne ACUM</a>
        </div>

        <div class="package-card card card--popular reveal">
          <div class="package-card__emoji">🎯</div>
          <h3 class="package-card__name">Pachetul 5 Garantat</h3>
          <div class="package-card__price">120 lei <span>/ oră</span></div>
          <p class="package-card__desc">De la zero la trecere. Acoperim bazele, umplem lacunele și trecem prin tiparele de examen.</p>
          <div class="package-card__features">
            <div class="package-card__feature">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              Recapitulare noțiuni de bază (și din liceu)
            </div>
            <div class="package-card__feature">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              Ședințe structurate săptămânal
            </div>
            <div class="package-card__feature">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              Ajutor la teme și proiecte
            </div>
            <div class="package-card__feature">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              Obiectiv: Nota 6-7 curată
            </div>
          </div>
          <a href={`https://wa.me/${waNumber}?text=Salut!%20Vreau%20Pachetul%205%20Garantat.%20Când%20aveți%20disponibilitate?`} target="_blank" rel="noopener" class="btn btn--primary">Programează o ședință</a>
        </div>

        <div class="package-card card card--glow reveal">
          <div class="package-card__emoji">🚀</div>
          <h3 class="package-card__name">Modul Prestanță / Bursă</h3>
          <div class="package-card__price">120 lei <span>/ oră</span></div>
          <p class="package-card__desc">Pentru cei care vor nota 9-10. Detaliem conceptele complexe, rezolvăm subiecte capcană.</p>
          <div class="package-card__features">
            <div class="package-card__feature">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              Exerciții avansate și subiecte din anii trecuți
            </div>
            <div class="package-card__feature">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              Optimizare timp de rezolvare
            </div>
            <div class="package-card__feature">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              Obiectiv: Nota 9-10 și bursă
            </div>
          </div>
          <a href={`https://wa.me/${waNumber}?text=Salut!%20Vreau%20Modul%20Prestanță%20pentru%20note%20mari.%20Când%20aveți%20disponibilitate?`} target="_blank" rel="noopener" class="btn btn--primary">Programează o ședință</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ CALCULATOR ═══ -->
  <div class="reveal">
    <Calculator />
  </div>

  <!-- ═══ TESTIMONIALE ═══ -->
  <div class="reveal">
    <Testimonials />
  </div>

  <!-- ═══ FAQ ═══ -->
  <div class="reveal">
    <FAQ />
  </div>

  <!-- ═══ CTA FINAL ═══ -->
  <section class="cta-section reveal">
    <div class="container">
      <p class="section__pretitle">Gata de treabă?</p>
      <h2 class="cta-section__title">Completează formularul și programează o ședință</h2>
      <p class="cta-section__desc section__subtitle">120 lei/oră • 150 lei/oră urgențe • Desfășurare exclusiv online</p>
      <a href="/programare" class="btn btn--primary">
        <svg class="btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        Programează acum o ședință
      </a>
    </div>
  </section>

</BaseLayout>
