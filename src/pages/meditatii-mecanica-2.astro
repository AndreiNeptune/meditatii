---
import BaseLayout from '../layouts/BaseLayout.astro';
import IconGear from '../components/icons/IconGear.astro';
import FAQ from '../components/FAQ.astro';
import '../styles/blueprint.css';
---

<BaseLayout
  title="Meditații Mecanică 2 Politehnică | Dinamică și Mecanică Analitică"
  description="Treci examenul de Dinamică la UNSTPB! Exerciții pas cu pas: Teoremele generale și ecuațiile lui Lagrange de speța a II-a. 120 lei/oră."
  currentPage="/meditatii-mecanica-2"
  whatsappMaterie="Mecanică 2 (Dinamică)"
>

  <section class="hero hero--subject" style="position: relative; overflow: hidden;">
    <div class="hero__grid"></div>

    <!-- Blueprint Hero Collage -->
    <div class="mecanica-hero-collage">
      <img src="/problema%20de%20cinematica%20mecanica%202.PNG" alt="Problemă cinematică mecanica 2" loading="lazy" />
      <img src="/problema%20de%20mecanica%202%20cinematica.PNG" alt="Problemă mecanica 2 cinematică" loading="lazy" />
    </div>

    <div class="container" style="position: relative; z-index: 2;">
      <div class="hero__content" style="max-width: 600px;">
        <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: var(--space-lg);">
          <IconGear class="hero__icon" size={56} style="margin-bottom: 0;" />
          <p class="hero__pretitle" style="margin-bottom: 0; font-size: 1.4rem;">Mecanică 2 — Dinamică</p>
        </div>
        <h1 class="hero__title">Scapă de stresul <span>ecuațiilor diferențiale</span></h1>
        <p class="hero__subtitle">
          Dinamica este unul dintre cele mai grele examene. Ca să treci, trebuie să știi să rezolvi problemele, nu doar să copiezi formule. <strong>Focusul nostru va fi 100% pe exerciții.</strong> Te ajutăm să aplici corect teoremele generale și ecuațiile lui Lagrange fără să te pierzi în derivate.
        </p>
        <div class="hero__actions">
          <a href="https://wa.me/NUMAR_TAU?text=Salut!%20Am%20nevoie%20de%20ajutor%20la%20Mecanică%202%20(Dinamică).%20Când%20aveți%20disponibilitate?" target="_blank" rel="noopener" class="btn btn--whatsapp">
            <svg class="btn__icon" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.126.553 4.126 1.52 5.867L.057 23.306a.75.75 0 0 0 .92.92l5.44-1.463A11.944 11.944 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>
            Contactează-ne pe WhatsApp
          </a>
        </div>
        <p class="hero__micro">120 lei/oră • 150 lei/oră urgențe</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="reveal">
        <p class="section__pretitle">Ce facem la Dinamică</p>
        <h2 class="section__title">Rezolvăm fix tipurile de probleme de la examen</h2>
      </div>

      <div class="topic reveal">
        <div class="topic__icon-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg></div>
        <div class="topic__content">
          <h3 class="topic__title">1. Teoremele Generale ale Dinamicii</h3>
          <div class="topic__list">
            <div class="topic__item">Exerciții cu Teorema impulsului și Teorema momentului cinetic.</div>
            <div class="topic__item">Probleme avansate cu Teorema energiei cinetice (calcul lucru mecanic).</div>
            <div class="topic__item">Dinamica punctului material și a sistemelor de puncte materiale.</div>
          </div>
        </div>
      </div>

      <div class="topic reveal">
        <div class="topic__icon-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></div>
        <div class="topic__content">
          <h3 class="topic__title">2. Mecanică Analitică (Cel mai important subiect!)</h3>
          <div class="topic__list">
            <div class="topic__item"><strong>Calculul gradelor de libertate</strong> pentru sisteme complexe și alegerea coordonatelor generalizate.</div>
            <div class="topic__item"><strong>Ecuațiile lui Lagrange de speța a II-a:</strong> Te învățăm algoritmul prin care scrii energia cinetică, forțele generalizate și derivezi corect.</div>
            <div class="topic__item">Un singur exercițiu Lagrange rezolvat curat îți asigură de cele mai multe ori trecerea!</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- GALLERY -->
  <section class="section" style="background: var(--bg-primary);">
    <div class="container">
      <div class="reveal" style="text-align: center; margin-bottom: var(--space-2xl);">
        <p class="section__pretitle">Portofoliu Mecanică 2</p>
        <h2 class="section__title">Exemple de lucrări rezolvate împreună</h2>
        <p class="section__subtitle" style="margin: 0 auto;">Vei învăța să rezolvi cap-coadă probleme complexe de cinematică și dinamică, la nivel de examen.</p>
      </div>

      <div class="gd-gallery reveal">
        <div class="gd-gallery__item">
          <img src="/problema%20de%20cinematica%20mecanica%202.PNG" alt="Problemă cinematică mecanica 2" class="blueprint-image" loading="lazy" />
          <h3 class="gd-gallery__title">Problemă de Cinematică</h3>
          <p style="font-size: 0.85rem; color: var(--text-muted);">Rezolvare pas cu pas a unui mecanism complex.</p>
        </div>
        <div class="gd-gallery__item">
          <img src="/problema%20de%20mecanica%202%20cinematica.PNG" alt="Problemă mecanica 2 cinematică" class="blueprint-image" loading="lazy" />
          <h3 class="gd-gallery__title">Analiză Cinematică</h3>
          <p style="font-size: 0.85rem; color: var(--text-muted);">Calculul vitezelor și accelerațiilor pentru fiecare element.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--bg-secondary);">
    <div class="container">
      <div class="solution-box reveal">
        <svg class="solution-box__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <div>
          <h3 style="margin-bottom: 0.5rem;">Calcul ordonat, fără greșeli</h3>
          <p>La Mecanică 2 uiți un termen într-o derivată și greșești tot. Te vom antrena să lucrezi ordonat, să faci diagrame de corp liber corecte și să duci calculele până la capăt. <strong>Nu te lăsăm până nu stăpânești logica rezolvării.</strong></p>
        </div>
      </div>
    </div>
  </section>

  <div class="reveal"><FAQ /></div>

  <section class="cta-section reveal">
    <div class="container">
      <h2 class="cta-section__title">Nu știi cum să aplici Lagrange?</h2>
      <p class="cta-section__desc section__subtitle">Trimite-ne un mesaj pe WhatsApp și te învățăm algoritmul în prima ședință.</p>
      <a href="https://wa.me/NUMAR_TAU?text=Salut!%20Am%20nevoie%20de%20ajutor%20la%20Mecanică%202%20(Dinamică).%20Când%20aveți%20disponibilitate?" target="_blank" rel="noopener" class="btn btn--whatsapp">
        <svg class="btn__icon" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.126.553 4.126 1.52 5.867L.057 23.306a.75.75 0 0 0 .92.92l5.44-1.463A11.944 11.944 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>
        Programează pe WhatsApp
      </a>
    </div>
  </section>

</BaseLayout>
