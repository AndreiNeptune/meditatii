---
import BaseLayout from '../layouts/BaseLayout.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
---

<BaseLayout
  title="Despre Noi | Echipa Meditații Poli"
  description="Suntem o echipă de ingineri și foști studenți de top la Politehnică. Află cum te putem ajuta să iei examenele de Geometrie Descriptivă, Analiză, Mecanică și Desen Tehnic."
  currentPage="/despre-noi"
>

  <section class="hero hero--subject">
    <div class="hero__grid"></div>
    <div class="container">
      <div class="hero__content">
        <p class="hero__pretitle">Despre Noi</p>
        <h1 class="hero__title">Echipa din spatele <span>notelor de 10</span></h1>
        <p class="hero__subtitle">
          Suntem un grup de ingineri și foști studenți de top ai Politehnicii din București. Am trecut prin aceleași cursuri, am avut aceiași profesori exigenți și știm exact ce se cere la examene.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="reveal" style="text-align: center;">
        <p class="section__pretitle">Misiunea noastră</p>
        <h2 class="section__title">Să traducem limbajul academic pe înțelesul tuturor</h2>
      </div>

      <div class="pain-grid" style="margin-top: 3rem;">
        <div class="pain-card card reveal">
          <svg class="pain-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <h3 class="pain-card__title">Fără teorie abstractă</h3>
          <p class="pain-card__desc">Cursurile sunt pline de demonstrații matematice lungi, dar la examen ai de calculat forțe și integrale. Noi tăiem teoria inutilă și ne concentrăm strict pe algoritmii de rezolvare.</p>
        </div>
        <div class="pain-card card reveal">
          <svg class="pain-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <h3 class="pain-card__title">Eficiență maximă</h3>
          <p class="pain-card__desc">Timpul tău e limitat. De aceea am creat <strong>Modul Pompier</strong> și <strong>Pachetul 5 Garantat</strong> — ca să te învățăm în câteva ședințe ce nu ai înțeles într-un semestru întreg.</p>
        </div>
        <div class="pain-card card reveal">
          <svg class="pain-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          <h3 class="pain-card__title">Experiență de top</h3>
          <p class="pain-card__desc">Lucrăm cu sute de studenți în fiecare sesiune. Știm unde se greșește cel mai des, care sunt capcanele profesorilor și cum trebuie redactată o lucrare ca să nu pierzi puncte.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--bg-secondary);">
    <div class="container">
      <div class="solution-box reveal">
        <svg class="solution-box__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <div>
          <h3 style="margin-bottom: 0.5rem;">De ce să lucrezi cu noi?</h3>
          <p>Spre deosebire de un coleg mai mare care "te ajută și el cum poate", noi am transformat meditațiile într-un sistem. Avem materiale structurate, tablete grafice pentru explicații online clare și o rată de promovabilitate de peste 95% a studenților cu care lucrăm.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALE -->
  <div class="reveal">
    <Testimonials />
  </div>

  <!-- FAQ -->
  <div class="reveal">
    <FAQ />
  </div>

  <!-- CTA FINAL -->
  <section class="cta-section reveal">
    <div class="container">
      <p class="section__pretitle">Pregătit să iei examenul?</p>
      <h2 class="cta-section__title">Contactează-ne pe WhatsApp și stabilește prima ședință</h2>
      <p class="cta-section__desc section__subtitle">120 lei/oră • 150 lei/oră urgențe • Desfășurare exclusiv online</p>
      <a href="https://wa.me/NUMAR_TAU?text=Salut!%20Aș%20dori%20să%20programez%20o%20ședință%20cu%20echipa%20voastră." target="_blank" rel="noopener" class="btn btn--whatsapp">
        <svg class="btn__icon" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.126.553 4.126 1.52 5.867L.057 23.306a.75.75 0 0 0 .92.92l5.44-1.463A11.944 11.944 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.75c-1.875 0-3.654-.516-5.197-1.477l-.363-.215-3.762 1.011 1.011-3.762-.235-.374A9.698 9.698 0 0 1 2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75z"/></svg>
        Programează acum
      </a>
    </div>
  </section>

</BaseLayout>
