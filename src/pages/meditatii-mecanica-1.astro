---
import BaseLayout from '../layouts/BaseLayout.astro';
import IconBeam from '../components/icons/IconBeam.astro';
import FAQ from '../components/FAQ.astro';
const waNumber = import.meta.env.WHATSAPP_NUMBER || '40750208299';
---
<BaseLayout
  title="Meditații Mecanică 1 Politehnică | Statică și Cinematică"
  description="Scapă de restanța la Mecanică 1! Facem exercițiile împreună: Grinzi cu zăbrele, centre de masă, mișcarea punctului și a rigidului. 120 lei/oră."
  currentPage="/meditatii-mecanica-1"
  whatsappMaterie="Mecanică 1 (Statică și Cinematică)"
>

  <section class="hero hero--subject" style="position: relative; overflow: hidden;">
    <div class="hero__grid"></div>

    <!-- Blueprint Hero Collage -->
    <div class="gd-hero-collage">
      <img src="/t/statica sistemelor.webp" alt="Statică sisteme" loading="lazy" />
      <img src="/t/Torsorul de reducere al unui sistem de forțe.webp" alt="Torsorul de reducere" loading="lazy" />
      <img src="/t/echilibrul solidului rigid.webp" alt="Echilibrul solidului rigid" loading="lazy" />
    </div>

    <div class="container" style="position: relative; z-index: 2;">
      <div class="hero__content" style="max-width: 600px;">
        <IconBeam class="hero__icon" size={64} />
        <p class="hero__pretitle">Mecanică 1 — Statică & Cinematică</p>
        <h1 class="hero__title">Treci examenul <span>rezolvând exerciții</span></h1>
        <p class="hero__subtitle">
          La curs e plin de desene uriașe și demonstrații, dar la examen ai de calculat forțe și viteze. <strong>Ne axăm strict pe a face exercițiile.</strong> Te ajutăm să rezolvi cap-coadă orice problemă de Statică sau Cinematică cu metode clare și pași algoritmici.
        </p>
        <div class="hero__actions">
          <a href={`https://wa.me/${waNumber}?text=Salut! Am nevoie de ajutor la Mecanică 1. Când aveți disponibilitate?`} target="_blank" rel="noopener" class="btn btn--whatsapp">
            <svg class="btn__icon" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.126.553 4.126 1.52 5.867L.057 23.306a.75.75 0 0 0 .92.92l5.44-1.463A11.944 11.944 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>
            Contactează-ne pe WhatsApp
          </a>
        </div>
        <p class="hero__micro">120 lei/oră • 150 lei/oră urgențe</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="reveal">
        <p class="section__pretitle">Ce facem concret</p>
        <h2 class="section__title">Rezolvăm exerciții, nu tocim teorie</h2>
      </div>

      <div class="topic reveal">
        <div class="topic__icon-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22V8M5 12H2a10 10 0 0 0 20 0h-3"/><circle cx="12" cy="8" r="2"/></svg></div>
        <div class="topic__content">
          <h3 class="topic__title">1. Statică (Echilibrul corpurilor și sistemelor)</h3>
          <div class="topic__list">
            <div class="topic__item"><strong>Echilibrul pe plan sau obstacole:</strong> Roată/cilindru care urcă sau depășește un prag <i>h</i> sub forța <i>F</i> (stabilirea forței minime la desprindere, <i>N<sub>A</sub> → 0</i>). Determinarea forțelor normale și a unghiurilor de frecare (<i>F<sub>f</sub> ≤ μN<sub>B</sub></i>).</div>
            <div class="topic__item"><strong>Sisteme de bare articulate și cabluri:</strong> Structuri în reazeme fixe/mobile sau încastrate, solicitate de forțe concentrate (<i>P, F</i>), momente (<i>M</i>) și sarcini distribuite. Scrierea ecuațiilor de echilibru (<i>∑F<sub>ix</sub> = 0, ∑F<sub>iy</sub> = 0, ∑M<sub>iO</sub> = 0</i>) și calculul reacțiunilor (orizontale, verticale și momente de încastrare).</div>
            <div class="topic__item"><strong>Reducerea sistemelor de forțe:</strong> Calculul rezultantei <i>R</i> și al momentului rezultant <i>M<sub>O</sub></i> în spațiu 3D. Invariantul sistemului și ecuațiile axei centrale.</div>
            <div class="topic__item"><strong>Centre de masă / greutate:</strong> Calcul pentru suprafețe compuse prin tabele cu segmente, arii și coordonate (<i>x<sub>i</sub>, y<sub>i</sub></i>).</div>
          </div>
        </div>
      </div>

      <div class="topic reveal">
        <div class="topic__icon-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M14 8l-4 8M10 8l4 8"/></svg></div>
        <div class="topic__content">
          <h3 class="topic__title">2. Cinematică (Studiul mișcării)</h3>
          <div class="topic__list">
            <div class="topic__item">Cinematica punctului material (viteză și accelerație).</div>
            <div class="topic__item">Cinematica rigidului: translație, rotație, mișcare plan-paralelă.</div>
            <div class="topic__item">Centrele instantanee de rotație și accelerația Coriolis.</div>
          </div>
        </div>
      </div>

      <div class="topic reveal">
        <div class="topic__icon-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m4 0h10"/></svg></div>
        <div class="topic__content">
          <h3 class="topic__title">3. Modul de învățare la meditații</h3>
          <div class="topic__list">
            <div class="topic__item"><strong>Abordare algoritmică:</strong> Lucrăm pur analitic, bazat pe o succesiune logică de pași pentru fiecare tip de problemă.</div>
            <div class="topic__item"><strong>Diagrama de Corp Liber (DCL):</strong> Primul pas obligatoriu este „izolarea” corpului. Înlocuim legăturile (cabluri, reazeme) cu reacțiunile lor (<i>S, N, H, V</i>).</div>
            <div class="topic__item"><strong>Alegerea axelor convenabile:</strong> Pe plane înclinate folosim axe rotite (descompunem greutatea cu sin <i>α</i> și cos <i>α</i>).</div>
            <div class="topic__item"><strong>Ecuații scalare:</strong> La statică scriem direct ecuațiile de echilibru. La dinamică folosim tabelul cinematic, apoi ecuația de energie și izolările pentru eforturi interne.</div>
            <div class="topic__item"><strong>Calcul simbolic riguros:</strong> Rezolvarea sistemelor liniare de ecuații și verificarea numărului de ecuații independente.</div>
          </div>
        </div>
      </div>

      <div class="topic reveal">
        <div class="topic__icon-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg></div>
        <div class="topic__content">
          <h3 class="topic__title">4. Ce ai nevoie să știi (Cunoștințe preliminare)</h3>
          <div class="topic__list">
            <div class="topic__item"><strong>Trigonometrie și geometrie plană:</strong> Descompunerea vectorilor pe axe ortogonale (sin <i>α</i>, cos <i>α</i>, tg <i>α</i>) și brațul forței pentru calculul momentelor (<i>∑M = 0</i>).</div>
            <div class="topic__item"><strong>Calcul vectorial:</strong> Produsul vectorial (<i>r × F</i>) pentru momente în spațiul 3D și produsul scalar.</div>
            <div class="topic__item"><strong>Analiză matematică elementară:</strong> Derivate de ordin I și II în raport cu timpul (<i>ẋ, ẍ</i> sau <i>ω = θ̇, ε = θ̈</i>) și integrale nedefinite simple (mișcare balistică).</div>
            <div class="topic__item"><strong>Noțiuni fizice:</strong> Diferența dintre forțele exterioare și cele interioare (tensiuni), momente de inerție axiale (ex: <i>J = 1/2 mR<sup>2</sup></i>) și legile frecării uscate Coulomb.</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--bg-secondary);">
    <div class="container">
      <div class="solution-box reveal">
        <svg class="solution-box__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <div>
          <h3 style="margin-bottom: 0.5rem;">Focus 100% pe exerciții</h3>
          <p>Nu-ți predăm un curs de 2 ore în care vorbim singuri. <strong>Facem exercițiile împreună</strong> — tu scrii, noi te corectăm la fiecare ecuație de moment sau sumă de forțe. Până la final, vei ști să scoți corect orice necunoscută din sistem.</p>
        </div>
      </div>
    </div>
  </section>

  <div class="reveal"><FAQ /></div>

  <!-- GALLERY -->
  <section class="section" style="background: var(--bg-primary);">
    <div class="container">
      <div class="reveal" style="text-align: center; margin-bottom: var(--space-2xl);">
        <p class="section__pretitle">Portofoliu Mecanică 1</p>
        <h2 class="section__title">Exemple de probleme rezolvate împreună</h2>
        <p class="section__subtitle" style="margin: 0 auto;">Până la finalul meditațiilor vei ști să rezolvi singur aceste tipuri de probleme, scriind corect toate ecuațiile de echilibru.</p>
      </div>

      <div class="gd-gallery reveal">
        <div class="gd-gallery__item">
          <img src="/t/metoda izolarii corpurilor.webp" alt="Metoda izolării corpurilor" class="blueprint-image" loading="lazy" />
          <h3 class="gd-gallery__title">Metoda izolării corpurilor</h3>
          <p style="font-size: 0.85rem; color: var(--text-muted);">Izolarea corectă a subsistemelor și înlocuirea legăturilor.</p>
        </div>
        <div class="gd-gallery__item">
          <img src="/t/echilibrul solidului rigid cu forte compuse.webp" alt="Echilibrul cu forțe compuse" class="blueprint-image" loading="lazy" />
          <h3 class="gd-gallery__title">Echilibrul solidului rigid</h3>
          <p style="font-size: 0.85rem; color: var(--text-muted);">Sisteme de forțe compuse, sarcini distribuite și momente.</p>
        </div>
        <div class="gd-gallery__item">
          <img src="/t/Centre de greutate pentru sisteme de bare .webp" alt="Centre de greutate pentru sisteme de bare" class="blueprint-image" loading="lazy" />
          <h3 class="gd-gallery__title">Sisteme de bare</h3>
          <p style="font-size: 0.85rem; color: var(--text-muted);">Calculul centrului de greutate pentru structuri liniare compuse.</p>
        </div>
        <div class="gd-gallery__item">
          <img src="/t/Centre de masă pentru plăci compuse.webp" alt="Centre de masă plăci compuse" class="blueprint-image" loading="lazy" />
          <h3 class="gd-gallery__title">Plăci compuse</h3>
          <p style="font-size: 0.85rem; color: var(--text-muted);">Împărțirea în suprafețe simple și calculul tabelar al coordonatelor (x, y).</p>
        </div>
        <div class="gd-gallery__item">
          <img src="/t/Centre de masă pentru plăci plane decupate.webp" alt="Plăci plane decupate" class="blueprint-image" loading="lazy" />
          <h3 class="gd-gallery__title">Plăci plane cu goluri</h3>
          <p style="font-size: 0.85rem; color: var(--text-muted);">Metoda ariilor negative pentru decupări circulare sau dreptunghiulare.</p>
        </div>
        <div class="gd-gallery__item">
          <img src="/t/Centrul de greutate al liniilor (curbelor) plane omogene.webp" alt="Centrul de greutate al curbelor" class="blueprint-image" loading="lazy" />
          <h3 class="gd-gallery__title">Centrul de greutate pentru curbe</h3>
          <p style="font-size: 0.85rem; color: var(--text-muted);">Integrare și formule standard pentru arce de cerc sau linii omogene.</p>
        </div>
        <div class="gd-gallery__item">
          <img src="/t/Centrul de greutate al suprafețelor plane omogene.webp" alt="Centrul de greutate al suprafețelor" class="blueprint-image" loading="lazy" />
          <h3 class="gd-gallery__title">Suprafețe plane omogene</h3>
          <p style="font-size: 0.85rem; color: var(--text-muted);">Determinarea coordonatelor centrului de masă pentru plăci standard.</p>
        </div>
        <div class="gd-gallery__item">
          <img src="/t/Reducerea forțelor concurente și oarecare în 3D.webp" alt="Reducerea forțelor în 3D" class="blueprint-image" loading="lazy" />
          <h3 class="gd-gallery__title">Reducerea forțelor concurente</h3>
          <p style="font-size: 0.85rem; color: var(--text-muted);">Calculul rezultantei și adunarea vectorială a forțelor 3D oarecare.</p>
        </div>
        <div class="gd-gallery__item">
          <img src="/t/Sisteme 3D de forțe.webp" alt="Sisteme 3D de forțe" class="blueprint-image" loading="lazy" />
          <h3 class="gd-gallery__title">Sisteme 3D complexe</h3>
          <p style="font-size: 0.85rem; color: var(--text-muted);">Proiecții pe axe și descompunerea vectorială a forțelor în spațiu.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-section reveal">
    <div class="container">
      <h2 class="cta-section__title">Te-ai blocat la o grindă cu zăbrele?</h2>
      <p class="cta-section__desc section__subtitle">Trimite-ne pe WhatsApp problema ta și o rezolvăm la prima ședință.</p>
      <a href={`https://wa.me/${waNumber}?text=Salut! Am nevoie de ajutor la Mecanică 1. Când aveți disponibilitate?`} target="_blank" rel="noopener" class="btn btn--whatsapp">
        <svg class="btn__icon" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.126.553 4.126 1.52 5.867L.057 23.306a.75.75 0 0 0 .92.92l5.44-1.463A11.944 11.944 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>
        Programează pe WhatsApp
      </a>
    </div>
  </section>

</BaseLayout>
