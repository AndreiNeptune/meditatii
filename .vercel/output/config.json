{
	"version": 3,
	"routes": [
		{
			"src": "^/_astro(?:/(.*))$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/submit-lead/?$",
			"dest": "_render"
		},
		{
			"src": "^/meditatii-analiza-matematica/?$",
			"dest": "_render"
		},
		{
			"src": "^/meditatii-desen-tehnic/?$",
			"dest": "_render"
		},
		{
			"src": "^/meditatii-geometrie-descriptiva/?$",
			"dest": "_render"
		},
		{
			"src": "^/meditatii-mecanica-1/?$",
			"dest": "_render"
		},
		{
			"src": "^/meditatii-mecanica-2/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}